# Copy this file to ".env" and fill in the values. ".env" is never committed (see .gitignore).
# On Render, set the same names under Environment instead of using a file.

# The passkey used to sign in to /admin. Keep it only in your private ".env" / Render settings, never in this
# shareable example file.
ADMIN_PASSKEY=

# A long random string used to sign the admin session cookie (for example 40+ random characters).
# Changing it signs everyone out.
SESSION_SECRET=

# Neon connection string (Dashboard > Connection string). Leave empty on your own computer to use a
# throwaway local database in the ".data" folder instead.
DATABASE_URL=

# The public address of the site, with no trailing slash. It is printed inside every QR code, so it
# must be the real, permanent address before you print cards, for example https://yourname.com
PUBLIC_BASE_URL=

# Optional: the most cards one batch may contain (default 1000).
MAX_BATCH=

# Optional: how many days a gift stays available after the sender fills the form (default 7).
# When the time is up the gift's whole row is deleted.
GIFT_DAYS=

# The secret in your cleanup link. Set your scheduler (for example cron-job.org) to open this address once
# a day:   <PUBLIC_BASE_URL>/api/cron/cleanup?key=<this value>
# It deletes every expired gift. (The admin page shows the finished link, ready to copy.)
# Use at least 16 random characters. Leave empty to switch the cleanup link off.
CRON_SECRET=

# Set to "production" on Render.
NODE_ENV=
